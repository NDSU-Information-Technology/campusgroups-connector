<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.ndsu.eci.midpoint</groupId>
  <artifactId>campus-groups-connector</artifactId>
  <version>1.2.0-SNAPSHOT</version>
  <parent>
  	<version>1.5.2.0</version>
  	<groupId>com.evolveum.polygon</groupId>
  	<artifactId>connector-parent</artifactId>
  </parent>
  <name>Ready Education CampusGroups Connector</name>
  <properties>
  	<connectorPackage>edu.ndsu.eci.midpoint.campus_groups_connector</connectorPackage>
  	<connectorClass>CampusGroupsConnector</connectorClass>
  </properties>
  	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <version>0.17</version>
            </plugin>
		</plugins>
	</build>
  <scm>
  	<url>https://github.com/NDSU-Information-Technology/campusgroups-connector</url>
  	<connection>scm:git:ssh://git@github.com:NDSU-Information-Technology/campusgroups-connector.git</connection>
  	<developerConnection>scm:git:ssh://git@github.com:NDSU-Information-Technology/campusgroups-connector.git</developerConnection>
  	<tag>campus-groups-connector-1.2.0</tag>
  </scm>
  <dependencies>
  	<dependency>
  		<groupId>org.apache.axis2</groupId>
  		<artifactId>axis2-kernel</artifactId>
  		<version>2.0.1</version>
  	</dependency>
    <dependency>
      <groupId>org.apache.axis2</groupId>
      <artifactId>axis2-adb</artifactId>
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.axis2</groupId>
      <artifactId>axis2-transport-local</artifactId>
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.axis2</groupId>
      <artifactId>axis2-transport-http</artifactId>
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>5.6.2</version>
      <scope>compile</scope>
    </dependency> 
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-xml</artifactId>
      <version>2.21.2</version>
    </dependency>       
  </dependencies>
</project>
